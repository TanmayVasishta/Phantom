# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
*.spec

# Virtual environments
.venv/
venv/
env/

# PHANTOM runtime data (local only, not for sharing) — this is real
# conversation memory (ChromaDB vectors, LangGraph SQLite checkpoints), never
# belongs in a public repo for a privacy-first project.
data/chromadb/
data/backups/
data/chromadb_backup_*/
phantom_memory/
*.jsonl
logs/

# Phantom 2.0 (agent_v2/) runtime data — surrogate_maps/ holds the ONLY place
# original PII values touch disk (surrogate_map.py's whole design is that this
# stays local); .preload_complete is a per-machine timing cache. Neither is
# meaningful on another machine, and the surrogate maps must never leave this
# one.
agent_v2/data/

# API keys — NEVER commit these
config/settings.py

# Graphify output (pushed for project context)
# graphify-out/

# OS / Editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.user

# Misc
*.log
*.tmp

# Environment files
.env
*.env
